# RMW CRM API. Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1
LOG_LEVEL=info

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
# DB_SSL_CA=certs/aiven-ca.pem
DB_POOL_SIZE=10

# REDIS_URL=redis://localhost:6379   (unset: background jobs run in-process)

COOKIE_SECURE=false
# COOKIE_DOMAIN=
# 32+ random characters. Also encrypts stored integration tokens (Meta). Changing it invalidates them.
APP_ENCRYPTION_KEY=
OTP_SECRET=

SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE=
SMS_TEMPLATE_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=RMW CRM <no-reply@ritzmediaworld.com>

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ritzmediaworld.com

MPF_API_URL=
MPF_ADMIN_EMAIL=
MPF_ADMIN_PASSWORD=
MPF_CRM_EXPORT_KEY=
RMW_ENQUIRY_LIST_URL=
CT_API_URL=
CT_ADMIN_EMAIL=
CT_ADMIN_PASSWORD=
# Auto-sync every N minutes (0 = off). Also runs the Meta Lead Ads reconciliation sync when Meta is connected.
SYNC_INTERVAL_MINUTES=0

# Meta (Facebook + Instagram) Lead Ads. Disabled until APP_ID, APP_SECRET and REDIRECT_URI are set.
META_APP_ID=
META_APP_SECRET=
# Must be on the CRM web origin so the session cookie is sent: {APP_URL}/api/integrations/meta/oauth/callback
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/oauth/callback
META_API_VERSION=v23.0
# Facebook Login for Business apps: Configuration ID from Facebook Login for Business > Configurations.
META_LOGIN_CONFIG_ID=
# Random string; enter the same value as "Verify token" in the Meta app's Webhooks settings.
META_WEBHOOK_VERIFY_TOKEN=
