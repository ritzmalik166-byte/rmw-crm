NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1
LOG_LEVEL=info

# Aiven MySQL (Aiven console -> service -> Overview). Download the CA certificate to DB_SSL_CA.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_CA=./certs/aiven-ca.pem
DB_POOL_SIZE=10

# Redis for BullMQ + Socket.IO adapter. Leave empty in local dev to process jobs in-process.
REDIS_URL=

# Cookies. Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
COOKIE_DOMAIN=
APP_ENCRYPTION_KEY=   # >= 32 random chars

# SMS OTP gateway (GET ?apikey=&senderid=&number=&message=)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE="{otp} is your verification code. Don't share your code with anyone. Team CONTENAISSANCE"
SMS_TEMPLATE_ID=
OTP_SECRET=           # >= 32 random chars
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=RMW CRM <no-reply@ritzmediaworld.com>

# Web push: generate with `npm run vapid:generate`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ritzmediaworld.com

# Pull sync of existing leads
MPF_API_URL=https://apis.mypropertyfact.in/api/v1
MPF_CRM_EXPORT_KEY=
RMW_ENQUIRY_LIST_URL=https://rmw.ritzmediaworld.in/api/system-settings/contact-enquiry
CT_API_URL=https://www.contenaissance.com
CT_ADMIN_EMAIL=
CT_ADMIN_PASSWORD=
SYNC_INTERVAL_MINUTES=0
